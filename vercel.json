{
  "functions": {
    "Web Engineering project/**/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/(index\\.php)?",
      "dest": "/Web%20Engineering%20project/home/home.html"
    },
    {
      "src": "/(.*)",
      "dest": "/Web%20Engineering%20project/$1"
    }
  ]
}
